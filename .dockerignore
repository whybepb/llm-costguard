# Never ship secrets, local state or heavyweight local artefacts into the image.
.env
.env.*
!.env.example
.git
.github
.venv
venv
**/__pycache__
**/*.pyc
.pytest_cache
.mypy_cache
.ruff_cache
.DS_Store

# runtime state / logs (the container writes its own under /app/data/runtime)
data/
*.sqlite
*.sqlite-journal

# models are downloaded at build time into /app/models (the local copy may hold Apple/MLX or torch weights)
models/

# eval artefacts, cassettes, docs and dev tooling are not needed to serve
eval/
!eval/__init__.py
docs/
tests/
loadtest/
notebooks/
*.ipynb
