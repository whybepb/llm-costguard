# Copy to .env and fill in. .env is gitignored; never commit real values.
ANTHROPIC_API_KEY=

# Langfuse (self-hosted, docker compose profile "langfuse"). Generate secrets with:
#   openssl rand -hex 32
# The project keys can be any strings with these prefixes; Langfuse creates the project with them.
LANGFUSE_PUBLIC_KEY=pk-lf-
LANGFUSE_SECRET_KEY=sk-lf-
LANGFUSE_HOST=http://localhost:3001
LANGFUSE_INIT_USER_EMAIL=admin@costguard.local
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
LANGFUSE_MINIO_PASSWORD=
