   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "Value": true,
       "__name__": true,
       "instance": true,
       "job": true
      },
      "indexByName": {
       "request_id": 0,
       "tenant": 1,
       "layer": 2,
       "model": 3,
       "quality": 4,
       "query": 5
      }
     }
